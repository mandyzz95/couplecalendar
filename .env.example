# Copy to .env for local development. On Vercel, add these in Project → Settings → Environment Variables.

# --- Database (Supabase → Project Settings → API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key   # keep secret, server only

# --- Assistant: Claude (console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-5-5

# --- Assistant: optional OpenAI-compatible model (used for visitors in regions Claude does not serve,
#     or on its own if you leave ANTHROPIC_API_KEY empty). Examples: DeepSeek, Qwen (DashScope), Kimi.
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-flash

# --- Optional: only these calendars use Claude (comma-separated ids from the ?c= link); all others use the model above
# CLAUDE_CALENDARS=yourCalendarId

# --- Spending guard: assistant messages per calendar per day ---
DAILY_AI_LIMIT=60
# --- Whole-site cap: assistant messages per day across every calendar ---
GLOBAL_DAILY_AI_LIMIT=200
